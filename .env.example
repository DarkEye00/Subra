# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=subra.example.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://subra.example.co.ke
SITE_URL=https://subra.example.co.ke
DOMAIN=subra.example.co.ke
POSTGRES_PASSWORD=
# Set by docker-compose; only needed when running outside Docker:
# DATABASE_URL=postgres://subra:password@localhost:5432/subra
# REDIS_URL=redis://localhost:6379/0

# --- Claude API ---
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5
ESCALATION_MODEL=claude-opus-5-5
PLANNER_EFFORT=medium
ESCALATION_EFFORT=high
AI_DAILY_CAP_USD=10
# A cheap first pass labels each slide for the planner (about KES 1 per deck). 0 to skip it.
POLISHER_CLASSIFIER=1
CLASSIFIER_MODEL=claude-haiku-5-5
# Vision QA scores every rendered slide and repairs low scores. Off at launch; roughly KES 5-10 per deck when on.
VISION_QA=0
VISION_MODEL=claude-haiku-5-5
# A generation or theme switch is killed after this many seconds and the deck marked as failed.
JOB_TIME_LIMIT_SECONDS=600
USD_KES_RATE=129.20
CARD_FX_MARKUP=0.03

# --- DigitalOcean Spaces (private bucket) ---
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1

# --- Payments: M-Pesa via Paystack (Starter Business) ---
PAYMENT_PROVIDER=paystack
# Test key first (sk_test_...), the live key once Starter KYC is approved. It also verifies webhooks.
# Webhook URL to set in the Paystack dashboard: https://<your domain>/billing/webhooks/paystack/
PAYSTACK_SECRET_KEY=
# Paystack Starter Businesses stop collecting at this lifetime total; alerts at 80% and 95%. 0 once registered.
PAYSTACK_STARTER_LIMIT_KES=250000
# Used only when the provider doesn't report its fee (Paystack M-Pesa: 1.5%)
PAYMENT_FEE_RATE=0.015
CARD_FEE_RATE=0.029

# --- Plans with credits and company accounts (Paystack Plans bill the cards) ---
# Off until the business is registered with Paystack, international cards are on, SMTP works, and
# manage.py sync_paystack_plans has created the plans. Needs EMAIL_HOST when DJANGO_DEBUG is off.
SUBSCRIPTIONS_ENABLED=0
# Emergency switch: no subscription lapses and no credits expire while this is on (e.g. a Paystack outage).
RENEWALS_PAUSED=0
SUBSCRIPTION_GRACE_DAYS=7
CREDIT_CARRYOVER_MULTIPLE=2
INVITE_TTL_DAYS=7

# --- Alternative: IntaSend (needs a registered business); set PAYMENT_PROVIDER=intasend ---
INTASEND_ENV=sandbox
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
# The "challenge" you set on the webhook in the IntaSend dashboard.
# Webhook URL to register there: https://<your domain>/billing/webhooks/intasend/
INTASEND_WEBHOOK_SECRET=

# --- Email and alerts ---
ADMIN_ALERT_EMAIL=
SUPPORT_EMAIL=
DEFAULT_FROM_EMAIL=SUBRA <no-reply@subra.example.co.ke>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Policy ---
# Paid decks are kept FILE_RETENTION_DAYS after payment; unpaid ones UNPAID_RETENTION_HOURS.
FILE_RETENTION_DAYS=7
UNPAID_RETENTION_HOURS=48
# Set to 1 once the privacy and terms pages have been reviewed:
LEGAL_PAGES_REVIEWED=0
