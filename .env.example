# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=subra.example.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://subra.example.co.ke
SITE_URL=https://subra.example.co.ke
DOMAIN=subra.example.co.ke
POSTGRES_PASSWORD=
# Set by docker-compose; only needed when running outside Docker:
# DATABASE_URL=postgres://subra:password@localhost:5432/subra
# REDIS_URL=redis://localhost:6379/0

# --- Claude API ---
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5
ESCALATION_MODEL=claude-opus-5-5
PLANNER_EFFORT=medium
ESCALATION_EFFORT=high
AI_DAILY_CAP_USD=10
USD_KES_RATE=129.20
CARD_FX_MARKUP=0.03

# --- DigitalOcean Spaces (private bucket) ---
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1

# --- M-Pesa (Daraja) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# A long random string. The callback URL is SITE_URL/billing/mpesa/callback/<secret>/
MPESA_CALLBACK_SECRET=
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till (then set MPESA_PARTY_B to the till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=

# --- Email and alerts ---
ADMIN_ALERT_EMAIL=
SUPPORT_EMAIL=
DEFAULT_FROM_EMAIL=SUBRA <no-reply@subra.example.co.ke>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Policy ---
FILE_RETENTION_DAYS=7
# Set to 1 once the privacy and terms pages have been reviewed:
LEGAL_PAGES_REVIEWED=0
