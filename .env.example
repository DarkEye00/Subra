# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=subra.example.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://subra.example.co.ke
SITE_URL=https://subra.example.co.ke
DOMAIN=subra.example.co.ke
POSTGRES_PASSWORD=
# Set by docker-compose; only needed when running outside Docker:
# DATABASE_URL=postgres://subra:password@localhost:5432/subra
# REDIS_URL=redis://localhost:6379/0

# --- Claude API ---
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5
ESCALATION_MODEL=claude-opus-5-5
PLANNER_EFFORT=medium
ESCALATION_EFFORT=high
AI_DAILY_CAP_USD=10
USD_KES_RATE=129.20
CARD_FX_MARKUP=0.03

# --- DigitalOcean Spaces (private bucket) ---
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=fra1

# --- Payments: M-Pesa via IntaSend ---
PAYMENT_PROVIDER=intasend
INTASEND_ENV=sandbox
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
# The "challenge" you set on the webhook in the IntaSend dashboard.
# Webhook URL to register there: https://<your domain>/billing/webhooks/intasend/
INTASEND_WEBHOOK_SECRET=
# Used only when IntaSend doesn't report its fee on a payment
PAYMENT_FEE_RATE=0.045

# --- Email and alerts ---
ADMIN_ALERT_EMAIL=
SUPPORT_EMAIL=
DEFAULT_FROM_EMAIL=SUBRA <no-reply@subra.example.co.ke>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Policy ---
# Paid decks are kept FILE_RETENTION_DAYS after payment; unpaid ones UNPAID_RETENTION_HOURS.
FILE_RETENTION_DAYS=7
UNPAID_RETENTION_HOURS=48
# Set to 1 once the privacy and terms pages have been reviewed:
LEGAL_PAGES_REVIEWED=0
